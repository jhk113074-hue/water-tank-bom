{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase-key.json",
      "firebase-debug.log",
      "**/.*",
      "**/node_modules/**",
      "**/*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://jhk113074-hue.github.io/water-tank-bom/:path*",
        "type": 301
      }
    ]
  }
}
